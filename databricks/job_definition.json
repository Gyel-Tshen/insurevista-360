{
  "name": "InsureVista_Medallion",
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "webhook_notifications": {},
  "timeout_seconds": 0,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "bronze_ingestion",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>/InsureVista/01_bronze_ingestion",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "silver_cleansing",
      "depends_on": [
        {
          "task_key": "bronze_ingestion"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>/InsureVista/02_silver_cleansing",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "gold_star_schema",
      "depends_on": [
        {
          "task_key": "silver_cleansing"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>/InsureVista/03_gold_star_schema",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    }
  ],
  "queue": {
    "enabled": true
  },
  "parameters": [
    {
      "name": "batch_id",
      "default": "manual"
    }
  ],
  "performance_target": "PERFORMANCE_OPTIMIZED"
}