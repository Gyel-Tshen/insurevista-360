  "visualStyles": {
    "page": {
      "*": {
        "background": [ { "color": { "solid": { "color": "#DCE3EC" } }, "transparency": 0 } ],
        "outspace": [ { "color": { "solid": { "color": "#DCE3EC" } }, "transparency": 0 } ]
      }
    },
    "*": {
      "*": {
        "background": [ { "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 } ],
        "border": [ { "show": true, "color": { "solid": { "color": "#C8D1DC" } }, "radius": 10 } ],
        "dropShadow": [ { "show": true } ],
        "title": [ { "show": true, "fontFamily": "Cambria", "fontSize": 14, "bold": true, "fontColor": { "solid": { "color": "#1F2A44" } }, "alignment": "center" } ]
      }
