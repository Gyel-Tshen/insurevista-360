  "background": "#FFFFFF",
  "foreground": "#1F2A44",
  "tableAccent": "#0B3C5D",
  "good": "#2A9D8F",
  "neutral": "#E9C46A",
  "bad": "#E76F51",
  "maximum": "#C0392B",
